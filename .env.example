# Copy .env.example to .env and fill in the private values locally.

##################################################
## Baserow credentials
# Baserow Cloud uses https://api.baserow.io. Change this for a self-hosted instance.
BASEROW_API_URL=https://api.baserow.io

# Paste the database token here. Do not add quotes or the "Token" prefix.
BASEROW_API_TOKEN=

# Baserow MCP server URL with access to the media database schema and rows.
BASEROW_MCP_URL=

##################################################
## Baserow database and table ids
# Media database ID
BASEROW_DATABASE_ID=

# Media table
BASEROW_MEDIA_TABLE_ID=

# Travel schedule table 
BASEROW_TRAVEL_SCHEDULE_TABLE_ID=

# Category, terms, folders table
BASEROW_CATEGORY_TERMS_TABLE_ID=

##################################################
## Youtube tokens
# Public read-only YouTube Data API v3 key for the Kadamba Foundation account.
YOUTUBE_API_KEY_KF=

# Public read-only YouTube Data API v3 key for the KKSBlog account.
YOUTUBE_API_KEY_KKSBLOG=

##################################################
## Folder paths
# Sample media files used during development. These are real samples from the archive 
MEDIA_SAMPLE_FILES_PATH=
# Processed files root folder. Media files will be moved in subfolders of this folder after processing.
MEDIA_PROCESSED_FILES_PATH=