# Copy .env.example to .env and fill in the private values locally.

##################################################
## Baserow credentials
# Baserow Cloud uses https://api.baserow.io. Change this for a self-hosted instance.
BASEROW_API_URL=https://api.baserow.io

# Paste the database token here. Do not add quotes or the "Token" prefix.
BASEROW_API_TOKEN=

# Baserow MCP server URL with access to the media database schema and rows.
BASEROW_MCP_URL=

##################################################
## Baserow database and table ids
# Media database ID
BASEROW_DATABASE_ID=

# Media table
BASEROW_MEDIA_TABLE_ID=

# Travel schedule table 
BASEROW_TRAVEL_SCHEDULE_TABLE_ID=

# Category, terms, folders table
BASEROW_CATEGORY_TERMS_TABLE_ID=

# Place -> country table (one row per media place_location)
BASEROW_PLACE_COUNTRY_TABLE_ID=

# Language words table (language, aliases)
BASEROW_LANGUAGE_TERMS_TABLE_ID=

# Country words table (country, aliases, ccTLD)
BASEROW_COUNTRY_TERMS_TABLE_ID=

##################################################
## Youtube tokens
# Public read-only YouTube Data API v3 key for the Kadamba Foundation account.
YOUTUBE_API_KEY_KF=

# Public read-only YouTube Data API v3 key for the KKSBlog account.
YOUTUBE_API_KEY_KKSBLOG=

##################################################
## Folder paths
# Sample media files used during development. These are real samples from the archive 
MEDIA_SAMPLE_FILES_PATH=
# Processed files root folder. Media files will be moved in subfolders of this folder after processing.
MEDIA_PROCESSED_FILES_PATH=
# Files without a WHAT wait in this folder (default: unprocessed-files in the repository).
MEDIA_UNPROCESSED_FILES_PATH=
# Byte-identical copies of a file are copied or moved here (default: identical-files).
MEDIA_IDENTICAL_FILES_PATH=
# Originals used during development; treated as read-only like the NAS.
# TRIMMING_SAMPLES_PATH=/path/to/media-archive-utils/trimming-samples

##################################################
## Media manager and tools (all optional; defaults shown)
# Root of the mounted NAS archive. Nothing is ever written below this folder.
# NAS_ROOT=/Volumes/archive
# Inbox folder watched for new files.
# INBOX_PATH=
# Transcripts folder.
# TRANSCRIPTIONS_PATH=/path/to/media-archive-utils/transcriptions

# Transcription: `auto` uses mlx-whisper on Apple Silicon and whisper.cpp elsewhere.
# TRANSCRIBER_BACKEND=auto
# WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo
# whisper.cpp (Windows): the whisper-cli path if it is not on PATH, and the GGML model file.
# WHISPER_CLI=
# WHISPER_CPP_MODEL=C:\models\ggml-large-v3-turbo.bin
# whisper.cpp device: `auto` tries the GPU (Metal) first and falls back to the local CPU.
# WHISPER_DEVICE=auto
# Word timestamps make transcribing slower; segment timestamps are enough for the tools.
# Sanskrit glossary (docs/references/sanskrit-glossary.json): TRANSCRIBE_GLOSSARY_FIX replaces known
# misspellings in the transcript with the glossary's spelling; TRANSCRIBE_GLOSSARY_PROMPT also gives
# Whisper the terms as its prompt (off until measured on real recordings).
# SANSKRIT_GLOSSARY_PATH=docs/references/sanskrit-glossary.json
# TRANSCRIBE_GLOSSARY_FIX=true
# TRANSCRIBE_GLOSSARY_PROMPT=false
# TRANSCRIBE_WORDS=false
# The recording is transcribed in chunks of about this many seconds (cut at the quietest spot),
# each in a watched process. A chunk that takes longer than the time limit is stopped and
# retried with Whisper's temperature fallback, then given to whisper.cpp when that is set up.
# TRANSCRIBE_CHUNK_S=300
# TRANSCRIBE_CHUNK_TIMEOUT_S=240
# Languages the recordings are in (ISO codes). Whisper hears Turkish or Hebrew in kirtan; a chunk
# detected as a language outside this list is decoded again in English.
# TRANSCRIBE_LANGUAGES=en,nl,de,fr,es,pt,it,hi,ru,cs,sk,pl,hr,sr,sl,bg,hu,sv,no,da,fi,lt,lv,et,uk,bn,ta,te
# Where verse pages are fetched from (cached in the local database for good).
# VEDABASE_URL=https://vedabase.io
# Seconds between two requests to vedabase.io (its robots.txt asks for 10).
# VEDABASE_DELAY_S=10

# Local state. Keep these on the local disk, never on the NAS share.
# LOCAL_DB_PATH=~/.mam/mam.sqlite
# WORK_DIR=~/.mam/work
# LOG_DIR=~/.mam/logs

# Name recorded on approvals (defaults to the OS user name).
# OPERATOR_NAME=

# Worker pools: ML (transcription), CPU (ffmpeg and the Kirtan splitter), I/O (copies and Baserow).
# WORKERS_CPU defaults to the number of cores minus 2 (at least 2, at most 8).
# WORKERS_ML=1
# WORKERS_CPU=8
# WORKERS_IO=4
# Run the Kirtan splitter's analysis in separate processes (several files at once).
# ANALYSIS_IN_PROCESSES=true
# Stop analysing a recording once the class is found (the cut cannot change after that).
# ANALYSIS_EARLY_STOP=true

# Random check: share of the Kirtan splitter's sure decisions that are sent to review anyway, to
# see how often it is right. 0 = off (no extra reviews), 0.05 = 1 in 20. The splitter does not
# learn from reviews yet.
# SPOT_CHECK_RATE=0.05
# Score below which a decision goes to review until enough reviews have taught the tool.
# START_THRESHOLD=0.9  (not used by the Kirtan splitter, which cuts when it is sure)
